# This app needs NO secrets or API keys: it runs fully offline on your iPhone.
# Nothing in this file is required. It exists only as a template.
#
# Optional — only if you build in the cloud from a CI server (not needed on your computer,
# where `npx eas-cli login` stores the session for you):
# EXPO_TOKEN=paste-a-token-from-expo.dev-account-settings-here
